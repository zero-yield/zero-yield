{
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/update-version.js ${nextRelease.version} && node scripts/release.js"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["version", "source"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/source.luau",
            "label": "source.luau"
          },
          {
            "path": "dist/source.min.luau",
            "label": "source.min.luau"
          }
        ]
      }
    ]
  ]
}
